# Copy to .env and adjust. Placeholder values only - never commit real secrets.

APP_NAME=InstaFlow
APP_ENV=development            # development | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret   # python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_ENCRYPTION_KEY=        # optional Fernet key; derived from SECRET_KEY when unset
# CORS_ORIGINS=["https://app.example.com"]

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Docker Compose overrides these two to point at its own services.
DATABASE_URL=postgresql+asyncpg://instaflow:instaflow@postgres:5432/instaflow
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=instaflow
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=instaflow

# Automation / workers
ACTION_MAX_ATTEMPTS=5
ACTION_RETRY_BASE_SECONDS=2
ACTION_RETRY_MAX_SECONDS=300
ACTION_TIMEOUT_SECONDS=15
ACCOUNT_RATE_LIMIT_PER_MINUTE=30
OUTBOX_RELAY_INTERVAL_SECONDS=5
# SIMULATION_WORKSPACE_ALLOWLIST=["<workspace-uuid>"]

# Instagram: "mock" (simulation, no credentials) or "live" (Meta API)
INSTAGRAM_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
META_APP_SECRET_PROTECTION_ENABLED=true
